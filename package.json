{
  "name": "resume-builder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @resume-builder/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @resume-builder/web test:watch",
    "coverage": "pnpm --filter @resume-builder/web coverage",
    "preview": "pnpm --filter @resume-builder/web preview",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "supabase": "^2.120.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
